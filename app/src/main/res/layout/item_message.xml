<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="2dp" android:paddingBottom="2dp">
    <LinearLayout android:id="@+id/bubble" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="310dp" android:minWidth="76dp" android:orientation="vertical" android:paddingStart="11dp" android:paddingTop="7dp" android:paddingEnd="9dp" android:paddingBottom="5dp">
        <TextView android:id="@+id/text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#E9EDEF" android:textSize="16sp" android:lineSpacingExtra="1dp"/>
        <TextView android:id="@+id/meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginStart="14dp" android:layout_marginTop="2dp" android:textColor="#93A4AD" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>