<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp"
    android:layout_width="match_parent" android:layout_height="72dp">
    <TextView android:text="PDF" android:textStyle="bold" android:textColor="#FFFFFF" android:gravity="center"
        android:background="#D94B4B" android:layout_width="48dp" android:layout_height="48dp"/>
    <LinearLayout android:orientation="vertical" android:layout_marginStart="14dp"
        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content">
        <TextView android:id="@+id/name" android:textColor="@color/docText" android:textSize="16sp"
            android:maxLines="1" android:ellipsize="end" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        <TextView android:id="@+id/meta" android:textColor="@color/docMuted" android:textSize="13sp"
            android:layout_width="match_parent" android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>