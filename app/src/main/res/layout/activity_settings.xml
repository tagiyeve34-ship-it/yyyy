<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="@color/bg"
    android:layout_width="match_parent" android:layout_height="match_parent">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Ayarlar" android:textColor="@color/text" android:textSize="28sp" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Bildirişlər" android:textColor="@color/green" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<Switch android:id="@+id/msgNotif" android:text="Mesaj bildirişi" android:textColor="@color/text" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Switch android:id="@+id/callSound" android:text="Zəng səsi" android:textColor="@color/text" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Switch android:id="@+id/readReceipt" android:text="Oxundu statusu" android:textColor="@color/text" android:checked="true" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Təhlükəsizlik" android:textColor="@color/green" android:textStyle="bold" android:layout_marginTop="22dp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
<TextView android:text="Tətbiqdən çıxdıqdan sonra lokal tarixçəni təmizlə" android:textColor="@color/text" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Spinner android:id="@+id/autoClear" android:entries="@array/auto_clear_options" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="48dp"/>
<TextView android:text="Yalnız bu cihazdakı görünən tarixçə sıfırlanır. Serverdə mesajlar silinmir və təmizlənmiş köhnə mesajlar yenidən göstərilmir." android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Messenger ekranlarında screenshot və Recent Apps önizləməsi bloklanır." android:textColor="@color/muted" android:textSize="13sp" android:layout_marginTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/logoutBtn" android:text="Sessiyadan çıx" android:layout_marginTop="28dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>