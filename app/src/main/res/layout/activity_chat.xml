<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#0B141A" android:fitsSystemWindows="true">
    <LinearLayout android:id="@+id/topBar" android:layout_width="0dp" android:layout_height="68dp" android:background="#111B21" android:gravity="center_vertical" android:paddingStart="4dp" android:paddingEnd="4dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <ImageButton android:id="@+id/backBtn" android:layout_width="46dp" android:layout_height="match_parent" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Geri" android:padding="12dp" android:src="@drawable/ic_back" app:tint="#E9EDEF"/>
        <TextView android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/avatar_circle" android:gravity="center" android:text="Q" android:textColor="#E9EDEF" android:textSize="18sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:orientation="vertical" android:paddingStart="10dp">
            <TextView android:id="@+id/name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="Qarşı tərəf" android:textColor="#E9EDEF" android:textSize="17sp" android:textStyle="bold"/>
            <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="aktivlik yoxlanılır…" android:textColor="#8696A0" android:textSize="12sp"/>
        </LinearLayout>
        <ImageButton android:id="@+id/videoBtn" android:layout_width="46dp" android:layout_height="52dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Video zəng" android:padding="11dp" android:src="@drawable/ic_video" app:tint="#E9EDEF"/>
        <ImageButton android:id="@+id/callBtn" android:layout_width="46dp" android:layout_height="52dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Zəng" android:padding="11dp" android:src="@drawable/ic_call" app:tint="#E9EDEF"/>
        <ImageButton android:id="@+id/settingsBtn" android:layout_width="42dp" android:layout_height="52dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Menyu" android:padding="10dp" android:src="@drawable/ic_more" app:tint="#E9EDEF"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="0dp" android:layout_height="0dp" android:clipToPadding="false" android:paddingStart="8dp" android:paddingTop="12dp" android:paddingEnd="8dp" android:paddingBottom="8dp" app:layout_constraintTop_toBottomOf="@id/topBar" app:layout_constraintBottom_toTopOf="@id/composer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout android:id="@+id/emojiPanel" android:layout_width="0dp" android:layout_height="310dp" android:background="#111B21" android:orientation="vertical" android:visibility="gone" app:layout_constraintBottom_toTopOf="@id/composer" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
            <ImageButton android:id="@+id/keyboardBtn" android:layout_width="44dp" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Klaviatura" android:padding="11dp" android:src="@drawable/ic_keyboard" app:tint="#8696A0"/>
            <HorizontalScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:scrollbars="none"><LinearLayout android:id="@+id/categoryRow" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal"/></HorizontalScrollView>
        </LinearLayout>
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#22303A"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <GridLayout android:id="@+id/emojiGrid" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="8" android:paddingStart="8dp" android:paddingTop="8dp" android:paddingEnd="8dp" android:paddingBottom="12dp"/>
        </ScrollView>
    </LinearLayout>

    <LinearLayout android:id="@+id/composer" android:layout_width="0dp" android:layout_height="wrap_content" android:background="#0B141A" android:gravity="bottom" android:minHeight="66dp" android:paddingStart="6dp" android:paddingTop="7dp" android:paddingEnd="7dp" android:paddingBottom="7dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/chat_input_bg" android:gravity="bottom|center_vertical" android:minHeight="50dp">
            <ImageButton android:id="@+id/emojiBtn" android:layout_width="46dp" android:layout_height="50dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Emoji" android:padding="11dp" android:src="@drawable/ic_emoji" app:tint="#8696A0"/>
            <EditText android:id="@+id/message" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@android:color/transparent" android:hint="Mesaj" android:inputType="textCapSentences|textMultiLine" android:maxLines="5" android:minHeight="50dp" android:paddingTop="11dp" android:paddingBottom="11dp" android:textColor="#E9EDEF" android:textColorHint="#8696A0" android:textSize="16sp"/>
            <ImageButton android:id="@+id/attachBtn" android:layout_width="44dp" android:layout_height="50dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="Əlavə et" android:padding="11dp" android:src="@drawable/ic_attach" app:tint="#8696A0"/>
        </LinearLayout>
        <ImageButton android:id="@+id/sendBtn" android:layout_width="52dp" android:layout_height="52dp" android:layout_marginStart="7dp" android:background="@drawable/circle_green" android:contentDescription="Göndər" android:padding="14dp" android:src="@drawable/ic_send" app:tint="#FFFFFF"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>